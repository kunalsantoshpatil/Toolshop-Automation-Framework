                "exec": [
                  "// Fetch email, password, and id from request body\r",
                  "const requestBody = pm.request.body.raw ? JSON.parse(pm.request.body.raw) : {};\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.environment.set(\"email\", response.email);\r",
                  "pm.environment.set(\"password\", requestBody.password);\r",
                  "\r",
                  "pm.environment.set(\"user_id\", response.id);\r",
